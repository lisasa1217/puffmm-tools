{
  "functions": {
    "api/ig.js": {
      "maxDuration": 60
    },
    "api/ar-hook.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/ig?action=refresh",
      "schedule": "0 3 * * 1"
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/labor-form/?$",
      "dest": "/labor-form.html"
    },
    {
      "src": "^/shorturl/?$",
      "dest": "/shorturl.html"
    },
    {
      "src": "^/lottery/?$",
      "dest": "/lottery.html"
    },
    {
      "src": "^/privacy/?$",
      "dest": "/privacy.html"
    },
    {
      "src": "^/autoreply/?$",
      "dest": "/autoreply.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}